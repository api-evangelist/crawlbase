{
  "opencollection": "1.0.0",
  "info": {
    "name": "Crawlbase Crawling API Leads API API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "token",
      "value": "{{token}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Leads API",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Discover emails for a domain",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.crawlbase.com/leads",
            "params": [
              {
                "name": "domain",
                "value": "",
                "type": "query",
                "description": "Bare domain (no scheme or path), for example slack.com."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum emails to return (default 10)."
              }
            ]
          },
          "docs": "Returns publicly visible email addresses associated with a bare `domain`, with the source URLs where each was found. Billed at one credit per ten emails. Documented by Crawlbase as closed to new sign-ups since 2024-10-01."
        }
      ]
    }
  ],
  "bundled": true
}