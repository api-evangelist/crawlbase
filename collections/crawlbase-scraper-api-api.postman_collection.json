          "id": "7f6357c7-de0c-469f-bfa3-6270ff797cc7",
          "name": "Scrape a supported site to structured JSON",
          "request": {
            "name": "Scrape a supported site to structured JSON",
            "description": {
              "content": "Applies a named `scraper` to the target `url` and returns provider-specific structured JSON (for example, amazon-product-details, google-serp, linkedin-company). Documented by Crawlbase as a legacy endpoint; the Crawling API's `&scraper=` parameter offers the same extractors.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "scraper"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "url",
                  "value": "<string>",
                  "description": "(Required) Fully URL-encoded target URL, including http:// or https://."
                },
                {
                  "disabled": false,
                  "key": "scraper",
                  "value": "<string>",
                  "description": "(Required) Name of the scraper/extractor to apply (see the Crawlbase scraper catalog)."
                },
                {
                  "disabled": false,
                  "key": "country",
                  "value": "<string>",
                  "description": "Two-letter ISO 3166 country code to geolocate the request (for example US, DE, GB)."
                },
                {
                  "disabled": false,
                  "key": "javascript",
                  "value": "<boolean>",
                  "description": "Render the page in Chrome before scraping (requires the JavaScript token)."
                },
                {
                  "disabled": false,
                  "key": "premium",
                  "value": "<boolean>",
                  "description": "Route through the premium residential proxy network."
                }
              ],
              "variable": []
            },
