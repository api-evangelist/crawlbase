            "description": {
              "content": "Renders the target `url` in headless Chrome and returns a screenshot. Requires the JavaScript token. Documented by Crawlbase as a legacy endpoint (closed to new sign-ups on 2024-11-01).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "screenshots"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "url",
                  "value": "<string>",
                  "description": "(Required) Fully URL-encoded target URL, including http:// or https://."
                },
                {
                  "disabled": false,
                  "key": "mode",
                  "value": "viewport",
                  "description": "viewport (visible area) or fullpage (entire scrollable page)."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "png",
                  "description": "Image output format."
                },
                {
                  "disabled": false,
                  "key": "width",
                  "value": "1280",
                  "description": "Viewport width in pixels."
                },
                {
                  "disabled": false,
                  "key": "height",
                  "value": "800",
                  "description": "Viewport height in pixels."
                },
                {
                  "disabled": false,
                  "key": "device",
                  "value": "desktop",
                  "description": "Device profile - desktop (default), tablet, or mobile."
                },
                {
                  "disabled": false,
                  "key": "store",
                  "value": "<boolean>",
                  "description": "Persist the capture in Cloud Storage."
