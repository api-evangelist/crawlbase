  "item": [
    {
      "id": "9589cf71-ebf9-46b9-a656-a7b93672195a",
      "name": "Crawling API",
      "description": {
        "content": "Fetch any URL through the rotating proxy network, optionally rendered.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "029bd864-13bf-4b61-8e81-933787c2a8a9",
          "name": "Crawl a URL",
          "request": {
            "name": "Crawl a URL",
            "description": {
              "content": "Fetches the target `url` through Crawlbase's proxy network and returns the page. Use the Normal (TCP) token for static HTML/JSON, or the JavaScript token to render the page in headless Chrome before returning it. Crawlbase status is surfaced in the `pc_status` response header; requests that do not return `pc_status: 200` are not charged.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "url",
                  "value": "<string>",
                  "description": "(Required) Fully URL-encoded target URL, including http:// or https://."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "html",
                  "description": "Response format - html (default), json, or md (Markdown)."
                },
                {
                  "disabled": false,
                  "key": "country",
                  "value": "<string>",
                  "description": "Two-letter ISO 3166 country code to geolocate the request (for example US, DE, GB)."
                },
                {
                  "disabled": false,
                  "key": "device",
                  "value": "desktop",
                  "description": "Device profile - desktop (default), tablet, or mobile."
                },
                {
                  "disabled": false,
                  "key": "user_agent",
                  "value": "<string>",
                  "description": "Override the User-Agent header sent to the target."
                },
                {
                  "disabled": false,
                  "key": "scraper",
                  "value": "<string>",
                  "description": "Name of a built-in extractor to apply to the crawled page (returns parsed JSON)."
                },
                {
                  "disabled": false,
                  "key": "autoparse",
                  "value": "<boolean>",
                  "description": "Auto-detect the page type and return parsed JSON."
                },
                {
                  "disabled": false,
                  "key": "page_wait",
                  "value": "<integer>",
                  "description": "Milliseconds to wait after page load before capture (JavaScript token only)."
                },
                {
                  "disabled": false,
                  "key": "ajax_wait",
                  "value": "<boolean>",
                  "description": "Wait for AJAX / network idle before capture (JavaScript token only)."
                },
                {
                  "disabled": false,
                  "key": "css_click_selector",
                  "value": "<string>",
                  "description": "CSS selector to click before capture (JavaScript token only)."
                },
                {
                  "disabled": false,
                  "key": "scroll",
                  "value": "<boolean>",
                  "description": "Scroll toward the bottom of the page before capture (JavaScript token only)."
                },
                {
                  "disabled": false,
                  "key": "scroll_interval",
                  "value": "<integer>",
                  "description": "Maximum seconds to scroll (default 10, max 60)."
                },
                {
                  "disabled": false,
                  "key": "screenshot",
                  "value": "<boolean>",
                  "description": "Capture a JPEG screenshot of the rendered page (JavaScript token only)."
                },
                {
                  "disabled": false,
                  "key": "get_headers",
                  "value": "<boolean>",
                  "description": "Return the target's response headers alongside the body."
                },
                {
                  "disabled": false,
                  "key": "get_cookies",
                  "value": "<boolean>",
                  "description": "Return the target's Set-Cookie values."
                },
                {
                  "disabled": false,
                  "key": "cookies_session",
                  "value": "<string>",
                  "description": "Sticky session identifier to reuse cookies across requests."
                },
                {
                  "disabled": false,
                  "key": "store",
                  "value": "<boolean>",
                  "description": "Persist the response in Crawlbase Cloud Storage."
                },
                {
                  "disabled": false,
                  "key": "async",
                  "value": "<boolean>",
                  "description": "Queue the request and return immediately with a request id (rid)."
                },
                {
                  "disabled": false,
                  "key": "callback",
                  "value": "<uri>",
                  "description": "Webhook URL that Crawlbase posts async results to."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/html"
              }
            ],
            "method": "GET",
