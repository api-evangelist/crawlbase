          "name": "Discover emails for a domain",
          "request": {
            "name": "Discover emails for a domain",
            "description": {
              "content": "Returns publicly visible email addresses associated with a bare `domain`, with the source URLs where each was found. Billed at one credit per ten emails. Documented by Crawlbase as closed to new sign-ups since 2024-10-01.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "leads"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "domain",
                  "value": "<string>",
                  "description": "(Required) Bare domain (no scheme or path), for example slack.com."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "10",
                  "description": "Maximum emails to return (default 10)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
